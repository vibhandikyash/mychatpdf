# Frontend
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_API_BASE_URL=http://localhost:8000

# Backend auth
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=

# Backend runtime
DATABASE_URL=postgresql+psycopg://mychatpdf:mychatpdf@postgres:5432/mychatpdf
REDIS_URL=redis://redis:6379/0
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300

# Wasabi S3-compatible storage
WASABI_ACCESS_KEY_ID=replace_me
WASABI_SECRET_ACCESS_KEY=replace_me
WASABI_BUCKET=mychatpdf-documents
WASABI_REGION=us-east-1
WASABI_ENDPOINT_URL=https://s3.wasabisys.com
WASABI_SIGNED_URL_EXPIRES_SECONDS=900

# OpenAI
OPENAI_API_KEY=replace_me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Pinecone
PINECONE_API_KEY=replace_me
PINECONE_INDEX_NAME=mychatpdf
PINECONE_NAMESPACE=dev

