VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
VITE_API_BASE_URL=http://127.0.0.1:8000
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_TIMEOUT_SECONDS=5
CLERK_AUDIENCE=
DATABASE_URL=postgresql+psycopg://mychatpdf:mychatpdf@postgres:5432/mychatpdf
REDIS_URL=redis://redis:6379/0
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300
WASABI_ACCESS_KEY_ID=your_wasabi_access_key_id
WASABI_SECRET_ACCESS_KEY=your_wasabi_secret_access_key
